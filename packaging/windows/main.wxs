<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user MSI: no elevation, installs under %LOCALAPPDATA%, which is where a
  tool that talks to your monitor has any business living.

  Built with the WiX 3 toolset:
    candle.exe -dVersion= -dBinDir= -dIconPath= main.wxs
    light.exe  -o ... main.wixobj
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="displaymux"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="tsukiyo20"
           UpgradeCode="8d1b7c34-2f60-4a1e-9c55-0b7a4e6d3f21">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of displaymux is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLDIR" Name="displaymux">
          <!--
            KeyPath is a registry value rather than the file itself: ICE38
            requires it for anything installed into the user profile, because a
            file there is not a reliable indicator that the component is
            installed for this user.
          -->
          <Component Id="GuiBinary" Guid="E56EC083-0579-4AEA-98D2-98F3D89184E3">
            <File Id="GuiExe" Source="$(var.BinDir)\dmux-gui.exe">
              <Shortcut Id="StartMenuShortcut"
                        Directory="ProgramMenuDir"
                        Name="displaymux"
                        WorkingDirectory="INSTALLDIR" />
            </File>
            <RegistryValue Root="HKCU" Key="Software\tsukiyo20\displaymux"
                           Name="GuiExe" Type="integer" Value="1" KeyPath="yes" />
            <!-- ICE64: a directory under the user profile has to be removed
                 explicitly, and this component owns the directory. -->
            <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
          </Component>
          <Component Id="CliBinary" Guid="1E0B7E32-1ED8-40A4-814A-02575C079A9F">
            <File Id="CliExe" Source="$(var.BinDir)\dmux.exe" />
            <RegistryValue Root="HKCU" Key="Software\tsukiyo20\displaymux"
                           Name="CliExe" Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <Component Id="HelperBinary" Guid="CBB348AA-2763-48A6-A071-D7268110DFFF">
            <File Id="HelperExe" Source="$(var.BinDir)\dmux-ddc-helper.exe" />
            <RegistryValue Root="HKCU" Key="Software\tsukiyo20\displaymux"
                           Name="HelperExe" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="displaymux" />
      </Directory>
    </Directory>

    <!-- The Start Menu folder itself, plus the uninstall entry's metadata. -->
    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="StartMenuFolder" Guid="4251E3DF-4568-4560-8F95-86751FD19387">
        <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\tsukiyo20\displaymux"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="displaymux" Level="1">
      <ComponentRef Id="GuiBinary" />
      <ComponentRef Id="CliBinary" />
      <ComponentRef Id="HelperBinary" />
      <ComponentRef Id="StartMenuFolder" />
    </Feature>

    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/tsukiyo20/displaymux" />
    <Property Id="ARPNOREPAIR" Value="1" />
  </Product>
</Wix>
